           <property name="styleSheet">
            <string notr="true">QTabWidget::pane { 
    border: 2px solid #8B0000; /* Bordure bordeaux */
    background-color: #F5F5DC; /* Fond beige */
    border-radius: 8px;
}

QTabBar::tab { 
    background: #FAF0E6;  /* Beige clair pour les onglets */
    color: #600000;        /* Texte bordeaux */
    padding: 10px 20px;
    font-size: 14px;
    font-family: &quot;Palatino Linotype&quot;;
    border: 2px solid #8B0000;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected { 
    background: #EDE0D4; /* Beige plus foncé pour l’onglet sélectionné */
    color: #600000;       /* Texte bordeaux */
    font-weight: bold;
    border-bottom: 2px solid #8B0000;
}

QTabBar::tab:hover {
    background: #D2B48C;  /* Beige doré pour le survol */
    color: #600000;
}

QTabWidget {
    background-color: #FAF0E6; /* Fond global beige */
    border: 2px solid #8B0000;
    border-radius: 8px;
}

</string>
