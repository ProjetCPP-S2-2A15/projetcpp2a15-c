          <property name="styleSheet">
           <string notr="true">QPushButton {
    background-color: #8B0000;  /* Rouge bordeaux */
    color: #F5F5DC;              /* Beige pour le texte */
    border-radius: 10px;         /* Coins arrondis */
    padding: 8px 15px;           /* Espacement intérieur */
    font-size: 14px;             /* Taille de police */
    font-weight: bold;           /* Police en gras */
    border: 2px solid #600000;   /* Bordure plus foncée */
}

QPushButton:hover {
    background-color: #A52A2A;   /* Rouge bordeaux plus clair */
    border: 2px solid #8B0000;   
}

QPushButton:pressed {
    background-color: #600000;   /* Rouge bordeaux très foncé */
    border: 2px solid #400000;
}

QPushButton:disabled {
    background-color: #D3B8AE;   /* Beige foncé pour désactivé */
    color: #8B0000;
    border: 2px solid #A52A2A;
}</string>
