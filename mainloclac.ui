          <property name="styleSheet">
           <string notr="true">QTableView {
    background-color: #FAF0E6; /* Fond beige */
    border: 2px solid #8B0000;  /* Bordure bordeaux */
    border-radius: 8px;
    font-size: 14px;
    font-family: &quot;Palatino Linotype&quot;;
}

QTableView::item {
    padding: 5px;
    border: 1px solid #8B0000;  /* Bordure autour des cellules */
    border-radius: 5px;
    color: #600000;  /* Texte bordeaux */
}

QTableView::item:selected {
    background-color: #EDE0D4; /* Beige plus foncé pour la cellule sélectionnée */
    color: #600000;             /* Texte bordeaux */
}

QTableView::item:hover {
    background-color: #D2B48C;  /* Beige doré pour l'élément survolé */
    color: #600000;              /* Texte bordeaux */
}

QHeaderView::section {
    background-color: #F5F5DC;  /* Fond beige clair pour les en-têtes */
    color: #600000;              /* Texte bordeaux */
    padding: 5px;
    border: 1px solid #8B0000;   /* Bordure de l’en-tête */
    font-weight: bold;
}

QHeaderView::section::horizontal {
    border-radius: 5px;
}

QTableView::indicator:checked {
    background-color: #8B0000;  /* Bordure ou fond de la case à cocher */
}</string>
