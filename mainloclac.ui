            <widget class="QLineEdit" name="lineEdit">
             <property name="styleSheet">
              <string notr="true">QLineEdit {
    color: #8B0000;             /* Texte en rouge bordeaux */
    background-color: #F5F5DC;  /* Fond beige */
    padding: 5px;               /* Espacement intérieur */
    border: 2px solid #600000;  /* Bordure bordeaux foncé */
    border-radius: 8px;         /* Coins arrondis */
    font-size: 14px;            /* Taille de police */
    font-family: &quot;Palatino Linotype&quot;; /* Police élégante */
}

QLineEdit:focus {
    border: 2px solid #A52A2A;  /* Bordure plus claire lorsqu'on clique */
    background-color: #FFFFFF;   /* Fond blanc subtil pour bien montrer le focus */
}

QLineEdit:disabled {
    background-color: #D3B8AE;   /* Beige foncé pour désactivé */
    color: #8B0000;              /* Texte en bordeaux */
    border: 2px solid #A52A2A;
}</string>
